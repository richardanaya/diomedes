# --- Required ---
FAL_KEY=your_fal_api_key_here
XAI_API_KEY=your_xai_api_key_here

# --- Optional ---
# Port the server listens on (default 3000)
# PORT=3000

# Models (defaults shown)
# XAI_MODEL=grok-4.3
# XAI_VISION_MODEL=grok-4.3

# Speculative prefetch of the most likely next scene (default true)
# ENABLE_PREFETCH=true

# Generate reference images for recurring NPCs to keep them consistent.
# Adds latency on first appearance; capped to 1 per turn. (default true)
# ENABLE_NPC_REFS=true

# After rendering, verify the image matches the brief and regenerate once if
# not. Adds one vision call per scene. (default false)
# ENABLE_FIDELITY_CHECK=false

# Max concurrent SAM segmentation calls (default 4)
# SAM_CONCURRENCY=4
